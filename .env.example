## ---- CMS Configuration ----
# Copy to .env and set values (never commit .env)
# Dev only — production refuses to start with placeholder/weak values (see validate-secrets.ts).
SESSION_SECRET=change-me-to-a-long-random-string

# Optional — path to admin user registry (default: auth.yaml in project root)
# AUTH_FILE=auth.yaml

## ---- Newsletter (Mailchimp embedded form) ----
# Audience → Signup forms → Embedded form → copy the form action URL
# Example: https://xxxxx.us21.list-manage.com/subscribe/post?u=USERID&id=LISTID
PUBLIC_MAILCHIMP_FORM_ACTION=
# Optional — usually derived from u + id in the action URL (b_USERID_LISTID)
# PUBLIC_MAILCHIMP_HONEYPOT=

## ---- Event registration (optional Turnstile) ----
# PUBLIC_TURNSTILE_SITEKEY=
# TURNSTILE_SECRET_KEY=

## ---- Nginx Configuration ----
# Optional — only while nginx site-wide Basic Auth is enabled (staging)
# NGINX_BASIC_AUTH_USER=
# NGINX_BASIC_AUTH_PASS=

## ---- Media storage (production) ----
# Absolute dir nginx serves at /media/. Leave unset locally (defaults to public/media).
# MEDIA_ROOT=/var/www/guanxi.at/media

## ---- Service Configuration ----
NODE_ENV=production
HOST=127.0.0.1
PORT=4329

## ---- Database Configuration ----
DATABASE_URL=./data/database_name.sqlite