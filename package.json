{
  "name": "cagdas-cecen-portfolio-website",
  "type": "module",
  "version": "1.0.2",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ],
    "*.{html,css,less,ejs,astro}": [
      "prettier --write",
      "git add"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --plugin=prettier-plugin-astro --write .",
    "prettier:check": "prettier --check --plugin=prettier-plugin-astro .",
    "cms:migrate": "tsx scripts/cms-migrate.ts",
    "cms:status": "tsx scripts/cms-status.ts",
    "cms:prune-media": "tsx scripts/cms-prune-media.ts",
    "hash_password": "tsx scripts/hash-password.ts",
    "db:sync-schema": "tsx scripts/db-sync-schema.ts",
    "db:generate": "npm run db:sync-schema && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:import-json": "tsx scripts/db-import-json.ts",
    "db:smoke": "tsx scripts/db-store-smoke.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/mdi": "^1.1.64",
    "astro": "^7.2.9",
    "astro-compressor": "^1.3.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "astro-icon": "^1.2.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.13.0"
  }
}
