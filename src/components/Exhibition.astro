---

const {title, organization, location, organizationUrl} = Astro.props;

---


<style>
    .exhibition {
        border-left: 2px solid rgba(0, 200, 150, 0.35);
        padding: 0.1rem 0 0.1rem 1rem;
        margin-bottom: 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        align-items: flex-start;
        justify-content: flex-start;
        flex-wrap: wrap;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.82rem;
        transition: border-color 0.15s ease;
    }

    .exhibition:hover {
        border-left-color: #00c896;
    }

    .exhibition--top {
        display: flex;
        width: 100%;
        min-width: 0;
        gap: 0.4rem 1rem;
        flex-wrap: wrap;
    }

    .exhibition--title {
        font-weight: 600;
        letter-spacing: 0.01em;
        color: #e4e4e4;
        min-width: 0;
        overflow-wrap: break-word;
    }

    .exhibition--organization {
        color: #9a9da4;
        min-width: 0;
        overflow-wrap: break-word;
    }

    .exhibition--organization a {
        color: inherit;
    }

    .exhibition--location {
        color: #9a9da4;
        opacity: 0.75;
        font-style: normal;
    }
</style>
<div class="exhibition">
    <div class="exhibition--top">
        <span class="exhibition--title">{title}</span>
        <span class="exhibition--organization">
            {organizationUrl === undefined ? organization : <a href={organizationUrl}>{organization}</a> }
        </span>
    </div>
    <span class="exhibition--location">{location}</span>
</div>