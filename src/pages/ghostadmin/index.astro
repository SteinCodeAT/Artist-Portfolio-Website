---
export const prerender = false;

import AdminAreaLayout from '@steincms/admin/layouts/AdminAreaLayout.astro';
import { listStaticPageEntries } from '@steincms/admin/nav';
import { getAuthenticatedUsername } from '@steincms/auth/admin-auth';
import DashboardHome from '../../components/admin/DashboardHome.astro';
import { siteConfig } from '../../site.config';
import { contentSchema } from '../../content.schema';
import { adminNav, adminPaths, adminLayoutText } from '../../admin-nav';
import { cms } from '../../cms';

const username = await getAuthenticatedUsername(Astro.request);
const posts = cms.postsStore?.loadPosts() ?? [];
const published = posts.filter((post) => post.status === 'published');
const drafts = posts.filter((post) => post.status === 'draft');
const pages = listStaticPageEntries(contentSchema, adminPaths);
const recent = cms.activityLog.readRecent(8);
const recentProjects = [...posts]
	.sort((a, b) => (b.updatedAt ?? '').localeCompare(a.updatedAt ?? ''))
	.slice(0, 5)
	.map((post) => ({
		id: post.id,
		title: post.title,
		year: post.year,
		status: post.status,
	}));
---

<AdminAreaLayout
	title={`Dashboard — ${siteConfig.admin.title}`}
	activeSection="home"
	adminPath={siteConfig.admin.path}
	adminTitle={siteConfig.admin.title}
	siteName={siteConfig.name}
	siteShortName={siteConfig.shortName}
	adminLogoSrc={siteConfig.admin.logo}
	navItems={adminNav}
	{...adminLayoutText}
>
	<DashboardHome
		username={username}
		subtitle={siteConfig.admin.title}
		projectsHref={`${adminPaths.base}/projects-manager`}
		newProjectHref={`${adminPaths.base}/projects-manager/bearbeiten`}
		pagesHref={adminPaths.staticPages}
		publishedCount={published.length}
		draftCount={drafts.length}
		pageCount={pages.length}
		recentProjects={recentProjects}
		pages={pages}
		recent={recent}
	/>
</AdminAreaLayout>
