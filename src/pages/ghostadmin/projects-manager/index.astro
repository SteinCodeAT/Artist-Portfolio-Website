---
// src/pages/ghostadmin/projects-manager/index.astro
export const prerender = false;

import AdminAreaLayout from '@steincms/admin/layouts/AdminAreaLayout.astro';
import AdminPostList from '@steincms/admin/components/AdminPostList.astro';
import AdminListCard from '@steincms/admin/components/AdminListCard.astro';
import ConfirmDeleteModal from '@steincms/admin/components/ConfirmDeleteModal.astro';
import { cms } from '../../../cms';
import { siteConfig } from '../../../site.config';
import { adminNav, adminPaths, adminLayoutText } from '../../../admin-nav';

const { postsStore } = cms;

function yearSortKey(year: string | null | undefined): number {
	if (!year) return 0;
	if (/upcoming/i.test(year)) return 9999;
	const years = year.match(/\d{4}/g);
	return years ? Math.max(...years.map(Number)) : 0;
}

const posts = postsStore
	? postsStore.loadPosts().sort((a, b) => yearSortKey(b.year) - yearSortKey(a.year))
	: [];
---

<AdminAreaLayout
	title={`Projects — ${siteConfig.admin.title}`}
	activeSection="blog"
	adminPath={siteConfig.admin.path}
	adminTitle={siteConfig.admin.title}
	siteName={siteConfig.name}
	siteShortName={siteConfig.shortName}
	adminLogoSrc={siteConfig.admin.logo}
	navItems={adminNav}
	{...adminLayoutText}
>
	<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
		<h1 style="margin:0;">Projects</h1>
		<a class="btn-ghost btn-sm" href={`${adminPaths.base}/projects-manager/bearbeiten`}>
			+ New Project
		</a>
	</div>

	<AdminPostList
		itemLabel="project"
		searchPlaceholder="Search projects…"
		deleteEndpoint="/api/posts"
		deleteItemLabel="Projekt"
	>
		{posts.map((post) => {
			const draft = post.previewDraft;
			const title = String(draft?.title ?? post.title);
			const excerpt = String(draft?.description ?? post.description);
			const year = String(draft?.year ?? post.year ?? '');
			const cover = (draft?.mainImage as string | undefined) || post.mainImage || '/favicon.svg';
			const neverPublished = post.status !== 'published';
			const meta = neverPublished
				? `Draft · ${year || 'no year set'}`
				: draft
					? `Published · Unpublished edits · ${year || 'no year set'}`
					: `Published · ${year || 'no year set'}`;
			const viewHref = neverPublished
				? `/projects/${post.slug}?show-preview=true`
				: `/projects/${post.slug}`;
			return (
			<AdminListCard
				id={post.id}
				title={title}
				excerpt={excerpt}
				meta={meta}
				coverSrc={cover}
				editHref={`${adminPaths.base}/projects-manager/bearbeiten?id=${post.id}`}
				viewHref={viewHref}
				viewLabel="View"
				editLabel="Edit"
				deleteLabel="Delete"
			/>
			);
		})}
	</AdminPostList>

	<ConfirmDeleteModal />
</AdminAreaLayout>
