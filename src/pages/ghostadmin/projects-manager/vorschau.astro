---
// src/pages/ghostadmin/projects-manager/vorschau.astro
// Draft preview — the real /projects/{slug} page only shows published CMS
// content once Phase 3 wires the public site to the CMS; until then this is
// the only way to see a draft before publishing.
export const prerender = false;

import AdminAreaLayout from '@steincms/admin/layouts/AdminAreaLayout.astro';
import { cms } from '../../../cms';
import { siteConfig } from '../../../site.config';
import { adminNav, adminPaths, adminLayoutText } from '../../../admin-nav';

const { postsStore } = cms;
const id = Astro.url.searchParams.get('id');
const post = id && postsStore ? postsStore.findPostById(id) : null;
---

<AdminAreaLayout
	title={`Preview — ${siteConfig.admin.title}`}
	activeSection="blog"
	adminPath={siteConfig.admin.path}
	adminTitle={siteConfig.admin.title}
	siteName={siteConfig.name}
	siteShortName={siteConfig.shortName}
	adminLogoSrc={siteConfig.admin.logo}
	navItems={adminNav}
	{...adminLayoutText}
>
	{!post ? (
		<p>Project not found — save it first.</p>
	) : (
		<article class="preview">
			<div class="preview-nav">
				<a class="back-link" href={`${adminPaths.base}/projects-manager/bearbeiten?id=${post.id}`}>&larr; Back to editor</a>
				<a class="back-link" href={`${adminPaths.base}/projects-manager`}>All Projects</a>
			</div>
			<p class="preview-badge" data-status={post.status}>{post.status === 'published' ? 'Published' : 'Draft preview'}</p>
			<p class="preview-note">
				This shows what's saved in the CMS right now — it's not the live public page's design
				(that still needs its own dynamic route reading from here).
			</p>
			{post.mainImage && <img class="preview-cover" src={post.mainImage} alt="" />}
			<h1>{post.title}</h1>
			<p class="preview-desc">{post.description}</p>
			<div class="preview-body">
				{post.blocks.map((block) => {
					if (block.type === 'text') return <div set:html={block.html} />;
					if (block.type === 'image') return (
						<figure>
							<img src={block.url} alt={block.alt} />
							{block.caption && <figcaption>{block.caption}</figcaption>}
						</figure>
					);
					if (block.type === 'gallery') return (
						<div class="preview-gallery">
							{block.images.map((img) => <img src={img.url} alt={img.alt ?? ''} />)}
						</div>
					);
					return null;
				})}
			</div>
		</article>
	)}
</AdminAreaLayout>

<style>
	.preview-nav {
		display: flex;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.back-link {
		display: inline-block;
		color: #666;
		text-decoration: none;
		font-size: 0.85rem;
	}
	.back-link:hover {
		color: #1a1a1a;
	}
	.preview-note {
		margin: 0 0 1.5rem;
		padding: 0.65rem 0.9rem;
		background: #f5f6f8;
		border-radius: 8px;
		font-size: 0.82rem;
		color: #667085;
		line-height: 1.4;
	}
	.preview {
		max-width: 48rem;
	}
	.preview-badge {
		display: inline-block;
		margin: 0 0 1rem;
		padding: 0.25rem 0.65rem;
		border-radius: 999px;
		background: #fef0c7;
		color: #b54708;
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.preview-badge[data-status='published'] {
		background: #d1fadf;
		color: #027a48;
	}
	.preview-cover {
		width: 100%;
		max-height: 24rem;
		object-fit: cover;
		border-radius: 12px;
		margin-bottom: 1.25rem;
	}
	h1 {
		margin: 0 0 0.5rem;
	}
	.preview-desc {
		color: #4a5568;
		font-size: 1.05rem;
		line-height: 1.6;
	}
	.preview-body {
		margin-top: 1.5rem;
		line-height: 1.7;
	}
	.preview-body figure {
		margin: 1.5rem 0;
	}
	.preview-body img {
		max-width: 100%;
		border-radius: 8px;
	}
	.preview-gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 0.75rem;
		margin: 1.5rem 0;
	}
	.preview-gallery img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 8px;
	}
</style>
