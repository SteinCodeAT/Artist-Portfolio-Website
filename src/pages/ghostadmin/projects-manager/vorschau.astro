---
// Draft preview — renders through the exact same ProjectPage layout the real
// public /projects/{slug} pages use (see [slug].astro), so what you see here
// is what publishing actually looks like. The public route only serves
// published posts, so this is the only way to see a draft before publishing.
export const prerender = false;

import ProjectPage from '../../../layouts/ProjectPage.astro';
import { videoTypes } from '../../../const.js';
import { cms } from '../../../cms';
import { adminPaths } from '../../../admin-nav';
import type { ContentBlock } from '../../../../steincms/cms/posts/posts-store';

const { postsStore } = cms;
const id = Astro.url.searchParams.get('id');
const post = id && postsStore ? postsStore.findPostById(id) : null;

const editorHref = post ? `${adminPaths.base}/projects-manager/bearbeiten?id=${post.id}` : `${adminPaths.base}/projects-manager`;

let project: {
	title: string;
	type: string;
	artist: string;
	verticaltext: string;
	videos: Array<{ src: string; type: string }>;
	images: string[];
	links: never[];
	textBlocks: Extract<ContentBlock, { type: 'text' }>[];
} | null = null;
if (post) {
	const blocks = post.blocks as ContentBlock[];
	const textBlocks = blocks.filter((b): b is Extract<ContentBlock, { type: 'text' }> => b.type === 'text');
	const galleryImages = blocks.flatMap((b) => {
		if (b.type === 'gallery') return b.images.map((img) => img.url);
		if (b.type === 'image') return b.url ? [b.url] : [];
		return [];
	});
	project = {
		title: post.title,
		type: post.year ?? '',
		artist: 'Çağdaş Çeçen',
		verticaltext: post.title,
		videos: post.videoEmbedUrl ? [{ src: post.videoEmbedUrl, type: videoTypes.external }] : [],
		images: galleryImages,
		links: [],
		textBlocks,
	};
}
---

{!post || !project ? (
	<html lang="en">
		<body style="background:#030406; color:#e4e4e4; font-family:system-ui,sans-serif; display:grid; place-items:center; min-height:100vh; margin:0;">
			<div>
				<p>Project not found — save it first.</p>
				<a href={editorHref} style="color:#00c896;">&larr; Back to editor</a>
			</div>
		</body>
	</html>
) : (
	<ProjectPage title={`Çağdaş Çeçen - ${post.title}`} description={post.description} project={project}>
		{/* position:fixed, so where it sits in ProjectPage's slot doesn't matter
		    visually — but it DOES need to be inside ProjectPage's own <body>,
		    not a sibling after it (ProjectPage renders a full <html> document
		    via its own Layout, so anything placed after </ProjectPage> here
		    would land outside </html> entirely — invalid, and browsers may
		    just drop it). */}
		<div class="preview-bar">
			<span class="preview-bar-badge" data-status={post.status}>{post.status === 'published' ? 'Published' : 'Draft Preview'}</span>
			<a class="preview-bar-link" href={editorHref}>&larr; Back to editor</a>
			<a class="preview-bar-link" href={`${adminPaths.base}/projects-manager`}>All Projects</a>
		</div>
		<style>
			.preview-bar {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 999;
				display: flex;
				align-items: center;
				gap: 1rem;
				padding: 0.6rem 1.25rem;
				background: rgba(3, 4, 6, 0.92);
				backdrop-filter: blur(8px);
				border-bottom: 1px solid rgba(228, 228, 228, 0.15);
				font-family: 'JetBrains Mono', ui-monospace, monospace;
				font-size: 0.78rem;
			}
			.preview-bar-badge {
				padding: 0.15rem 0.6rem;
				border-radius: 999px;
				background: #3a2c0f;
				color: #ffb020;
				font-weight: 700;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.preview-bar-badge[data-status='published'] {
				background: #0f3a2c;
				color: #00c896;
			}
			.preview-bar-link {
				color: #9a9da4;
				text-decoration: none;
			}
			.preview-bar-link:hover {
				color: #00c896;
			}
		</style>
		{project.textBlocks.map((block) => <Fragment set:html={block.html} />)}
	</ProjectPage>
)}
