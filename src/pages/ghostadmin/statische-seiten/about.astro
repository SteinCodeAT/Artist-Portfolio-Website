---
// src/pages/ghostadmin/statische-seiten/about.astro
export const prerender = false;

import AdminAreaLayout from '@steincms/admin/layouts/AdminAreaLayout.astro';
import SchemaForm from '@steincms/admin/components/SchemaForm.astro';
import {
	applyPreviewDraft,
	getCollectionRecord,
	getRecordFields,
	stripPreviewDraft,
	type PreviewDraftOverlay,
} from '@steincms/cms/schema';
import { readSingleton } from '@steincms/db/singletons-store';
import { siteConfig } from '../../../site.config';
import { contentSchema } from '../../../content.schema';
import { cmsDatabase } from '../../../db/cms-database';
import { adminNav, adminLayoutText } from '../../../admin-nav';

const record = getCollectionRecord(contentSchema.about)!;
const fields = getRecordFields(record);
const raw = readSingleton(cmsDatabase, 'about') ?? {};
const hasPreviewDraft = Boolean(raw.previewDraft);
const editingDraft = hasPreviewDraft;
const values = applyPreviewDraft(
	stripPreviewDraft(raw),
	raw.previewDraft as PreviewDraftOverlay | null | undefined,
	record,
);
---

<AdminAreaLayout
	title={`About — ${siteConfig.admin.title}`}
	activeSection="static-pages"
	adminPath={siteConfig.admin.path}
	adminTitle={siteConfig.admin.title}
	siteName={siteConfig.name}
	siteShortName={siteConfig.shortName}
	adminLogoSrc={siteConfig.admin.logo}
	navItems={adminNav}
	wideContent={false}
	{...adminLayoutText}
>
	<h1 style="margin:0 0 1.25rem;">About</h1>
	<div data-schema-collection="about">
		<SchemaForm
			fields={fields}
			values={values}
			hasPreviewDraft={hasPreviewDraft}
			editingDraft={editingDraft}
			previewHref="/?show-preview=true#about-me-section"
		/>
	</div>
</AdminAreaLayout>
