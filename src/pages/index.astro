---
import Layout from '../layouts/Layout.astro';

import SignalTV from '../components/SignalTV.astro'
import ArtistCV from '../components/ArtistCV.astro'

import CcProfileImage from '../img/cc-public.png'
import { cmsDatabase } from '../db/cms-database';
import { readSingleton } from '@steincms/db/singletons-store';

import '../styles/index.css';

const fallbackDescription = `
Media Art focusing on the relationship between
human movement, space and uncertainty and developing
new ways of interaction between humans and spaces.
`

// Read at BUILD time — this page is static (no prerender=false), so the CMS
// data gets baked into the HTML on the next `npm run build`, same as any
// other static-site CMS integration. Falls back to the original hardcoded
// content if the singleton was never saved (fresh install, no About content yet).
type AboutContent = {
	bio?: string;
	tagline?: string;
	photo?: string | null;
	instagramUrl?: string;
	instagramHandle?: string;
	email?: string;
	phone?: string;
	exhibitions?: string[];
	awards?: string[];
	curatorial?: string[];
	activities?: string[];
	education?: string[];
};
const about = readSingleton(cmsDatabase, 'about') as AboutContent | null;
const photoSrc = about?.photo || CcProfileImage.src;
const description = about?.tagline || fallbackDescription;
---

<Layout title="Çağdaş Çeçen - Media Artist" description={description}>

	<main>
		<a href="#main-card" class="sr-skip-link">
			Skip to main content
		</a>

	<section class="banner-section" id="main-card">
			<SignalTV />
		</section>


		<ArtistCV
			photoSrc={photoSrc}
			bio={about?.bio}
			tagline={about?.tagline}
			instagramUrl={about?.instagramUrl}
			instagramHandle={about?.instagramHandle}
			email={about?.email}
			phone={about?.phone}
			exhibitions={about?.exhibitions ?? []}
			awards={about?.awards ?? []}
			curatorial={about?.curatorial ?? []}
			activities={about?.activities ?? []}
			education={about?.education ?? []}
		/>

	</main>

	<style>
		.site-footer {
			position: relative;
			background: #030406;
			padding: 3.5rem 6vw 2.5rem;
			text-align: center;
			overflow: hidden;
		}

		.site-footer__rule {
			width: 40%;
			max-width: 220px;
			height: 1px;
			margin: 0 auto 2.25rem;
			background: linear-gradient(90deg, transparent, rgba(0, 200, 150, 0.6), transparent);
		}

		.site-footer__copyright {
			font-family: 'Rajdhani', 'Arial Narrow', sans-serif;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			font-size: clamp(1rem, 1.8vw, 1.25rem);
			color: #e4e4e4;
		}

		.site-footer__built {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.35em;
			margin-top: 0.85rem;
			font-family: 'JetBrains Mono', ui-monospace, monospace;
			font-size: 0.7rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: #9a9da4;
		}

		.site-footer__heart {
			display: inline-block;
			color: #00c896;
			text-shadow: 0 0 8px rgba(0, 200, 150, 0.7), 0 0 18px rgba(0, 200, 150, 0.4);
			animation: footer-pulse 1.8s ease-in-out infinite;
		}

		@keyframes footer-pulse {
			0%, 100% { transform: scale(1); opacity: 0.85; }
			50% { transform: scale(1.18); opacity: 1; }
		}

		.site-footer__credit {
			color: #00c896;
			text-decoration: none;
			border-bottom: 1px solid rgba(0, 200, 150, 0.4);
			transition: color 0.2s ease, border-color 0.2s ease, text-shadow 0.2s ease;
		}

		.site-footer__credit:hover {
			color: #ffb020;
			border-color: #ffb020;
			text-shadow: 0 0 10px rgba(255, 176, 32, 0.6);
			filter: none;
		}

		@media (prefers-reduced-motion: reduce) {
			.site-footer__heart {
				animation: none;
			}
		}
	</style>
	<footer class="site-footer">
		<div class="site-footer__rule"></div>
		<div class="site-footer__copyright">
			&copy; <span class="copyright-year"></span> Çağdaş Çeçen
		</div>
		<div class="site-footer__built">
			<span>Built with</span>
			<span class="site-footer__heart">♥</span>
			<span>in Vienna by</span>
			<a class="site-footer__credit" target="_blank" rel="noopener" href="https://steincode.com">SteinCode</a>
		</div>
	</footer>

	<script src="../scripts/copyright-year-updater.js"></script>
</Layout>


