---
// On-demand so admin edits (including authorized draft preview) read the live DB.
export const prerender = false;

import ProjectPage from '../../layouts/ProjectPage.astro';
import PreviewBar from '@steincms/components/PreviewBar.astro';
import { isAuthorizedRequest } from '@steincms/auth/admin-auth';
import { postForDisplay } from '@steincms/cms/posts/post-display';
import { findPostsCollection } from '@steincms/cms/schema';
import { cms } from '../../cms';
import { adminPaths } from '../../admin-nav';
import { videoTypes } from '../../const.js';
import type { ContentBlock } from '../../../steincms/cms/posts/posts-store';

const { slug } = Astro.params;
const raw = slug && cms.postsStore ? cms.postsStore.findPostBySlug(slug) : undefined;

if (!raw) {
	return new Response('Not found', { status: 404 });
}

const showPreview = Astro.url.searchParams.get('show-preview') === 'true';
const authorized = isAuthorizedRequest(Astro.request);

if ((!authorized || !showPreview) && raw.status !== 'published') {
	return new Response('Not found', { status: 404 });
}

const postsCollection = findPostsCollection(cms.contentSchema);
const { post, isPreview } = postForDisplay(
	raw,
	{ preview: showPreview, authorized },
	postsCollection?.def.record,
);

if (isPreview) {
	Astro.response.headers.set('Cache-Control', 'no-store');
}

const blocks = post.blocks as ContentBlock[];
const textBlocks = blocks.filter((b): b is Extract<ContentBlock, { type: 'text' }> => b.type === 'text');

const project = {
	title: post.title,
	// No separate "medium/type" field in the CMS — the meta line (medium,
	// venue, awards) lives as the first text block instead, shown via the
	// body below rather than duplicated here.
	type: post.year ?? '',
	artist: 'Çağdaş Çeçen',
	verticaltext: post.title,
	// External links are folded into the body's text blocks (a "Links"
	// section) rather than a separate structured field — see content.schema.ts.
	// videoEmbedUrl is the one exception: a single optional embed shown above
	// the write-up, same slot the old hardcoded pages used.
	videos: post.videoEmbedUrl ? [{ src: post.videoEmbedUrl, type: videoTypes.external }] : [],
	images: post.mainGallery ?? [],
	links: [],
};
---

<ProjectPage
	title={`Çağdaş Çeçen - ${post.title}`}
	description={post.description}
	project={project}
	noindex={isPreview}
>
	{isPreview && (
		<div class="project-preview-bar">
			<PreviewBar editorHref={`${adminPaths.base}/projects-manager/bearbeiten?id=${raw.id}`} />
		</div>
	)}
	{textBlocks.map((block) => <Fragment set:html={block.html} />)}
	{isPreview && (
		<style>
			.project-preview-bar {
				--steincms-preview-bar-bg: rgba(3, 4, 6, 0.92);
				--steincms-preview-bar-fg: #9a9da4;
				--steincms-preview-bar-border: rgba(228, 228, 228, 0.15);
				--steincms-preview-bar-badge-bg: #3a2c0f;
				--steincms-preview-bar-badge-fg: #ffb020;
				--steincms-preview-bar-accent: #00c896;
			}
		</style>
	)}
</ProjectPage>
