---
import type { AdminEditorAction, AdminEditorDraftBadge, AdminEditorPreview } from '../editor-actions';

interface Props {
	showStatus?: boolean;
	draftBadge?: AdminEditorDraftBadge | null;
	preview?: AdminEditorPreview | null;
	triggerLabel?: string;
	actions?: AdminEditorAction[];
}

const {
	showStatus = false,
	draftBadge = null,
	preview = null,
	triggerLabel = 'Speichern ▾',
	actions = [],
} = Astro.props;
---

<div class="toolbar-actions" data-editor-actions>
	<slot />
	{
		showStatus && (
			<span class="save-status" id="save-status" aria-live="polite"></span>
		)
	}
	{
		draftBadge && (
			<span class="draft-badge" title={draftBadge.title} hidden={draftBadge.hidden}>
				{draftBadge.label}
			</span>
		)
	}
	{
		preview && (
			<button
				type="button"
				class="btn-ghost editor-preview-btn"
				id="btn-preview"
				title={preview.title}
			>
				{preview.label}
			</button>
		)
	}
	{
		actions.length > 0 && (
			<div class="save-dropdown" data-save-dropdown>
				<button type="button" class="btn-primary save-dropdown-trigger" data-save-dropdown-trigger>
					{triggerLabel}
				</button>
				<div class="save-dropdown-menu" data-save-dropdown-menu hidden>
					{actions.map((item) => (
						<button
							type="button"
							class:list={['save-dropdown-item', { 'save-dropdown-item-danger': item.danger }]}
							data-save-action={item.action}
							hidden={item.hidden}
						>
							<strong>{item.label}</strong>
							{item.hint && <small>{item.hint}</small>}
						</button>
					))}
				</div>
			</div>
		)
	}
</div>

<script>
	import { initEditorSaveDropdowns } from '../scripts/editor-save-dropdown';

	initEditorSaveDropdowns();
</script>

<style>
	.toolbar-actions {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		align-items: center;
	}

	.save-status {
		font-size: 0.82rem;
		color: #667085;
		align-self: center;
	}

	.save-status.is-dirty {
		color: #b54708;
	}

	.save-status.is-saved {
		color: #027a48;
	}

	.draft-badge {
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.25rem 0.55rem;
		border-radius: 999px;
		background: #fef0c7;
		color: #b54708;
		border: 1px solid #fedf89;
	}

	.save-dropdown {
		position: relative;
	}

	.save-dropdown-menu {
		position: absolute;
		top: calc(100% + 0.35rem);
		right: 0;
		z-index: 30;
		min-width: 16.5rem;
		padding: 0.35rem;
		border: 1px solid #e4e7ec;
		border-radius: 10px;
		background: #fff;
		box-shadow: 0 8px 24px rgba(16, 24, 40, 0.12);
	}

	.save-dropdown-item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
		width: 100%;
		padding: 0.65rem 0.75rem;
		border: none;
		border-radius: 8px;
		background: transparent;
		text-align: left;
		font: inherit;
		cursor: pointer;
	}

	.save-dropdown-item:hover {
		background: #f5f6f8;
	}

	.save-dropdown-item strong {
		font-size: 0.92rem;
		color: #1a1a1a;
	}

	.save-dropdown-item small {
		font-size: 0.78rem;
		color: #667085;
		line-height: 1.35;
	}

	.save-dropdown-item-danger strong {
		color: #b42318;
	}

	@media (max-width: 600px) {
		.toolbar-actions {
			width: 100%;
		}

		.toolbar-actions .btn-ghost,
		.toolbar-actions .btn-primary {
			flex: 1;
			text-align: center;
		}

		.editor-preview-btn {
			flex: 0 0 100%;
		}
	}
</style>
