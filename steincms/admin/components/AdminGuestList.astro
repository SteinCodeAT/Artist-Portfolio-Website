---
import AdminIcon from '../icons/AdminIcon.astro';
import {
	answerPairsForGuest,
	type EventRegistrationForm,
	type RegistrationAnswerValue,
	type RegistrationQuestionSummary,
} from '@steincms/cms/events/registration-form';

interface GuestRow {
	name: string;
	email: string;
	guests: number;
	ticketCode?: string;
	answers?: Record<string, RegistrationAnswerValue>;
	createdAt: string;
}

interface Props {
	eventId: string;
	people: number;
	reportsLabel: string;
	registrations: GuestRow[];
	registrationForm: EventRegistrationForm;
	overview: RegistrationQuestionSummary[];
	eventTitle?: string;
	/** Compact layout inside the event editor tab (no top rule, taller list). */
	embedded?: boolean;
}

const {
	eventId,
	people,
	reportsLabel,
	registrations,
	registrationForm,
	overview,
	eventTitle = 'Event',
	embedded = false,
} = Astro.props;
const responseCount = Math.max(registrations.length, 1);
const showOverview = overview.length > 0 && registrations.length > 0;

function formatWhen(iso: string): string {
	return new Date(iso).toLocaleString('de-AT', {
		day: '2-digit',
		month: '2-digit',
		year: '2-digit',
		hour: '2-digit',
		minute: '2-digit',
	});
}

function initial(name: string): string {
	const letter = name.trim().charAt(0);
	return letter ? letter.toUpperCase() : '?';
}

function barWidth(count: number): string {
	return `${Math.round((count / responseCount) * 100)}%`;
}

const exportPayload = {
	title: eventTitle,
	fields: registrationForm.fields.map((field) => ({ id: field.id, label: field.label })),
	rows: registrations.map((row) => ({
		name: row.name,
		email: row.email,
		guests: row.guests,
		ticketCode: row.ticketCode ?? '',
		createdAt: formatWhen(row.createdAt),
		answers: Object.fromEntries(
			answerPairsForGuest(registrationForm, row.answers).map((pair) => [pair.question, pair.answer]),
		),
	})),
};
---

<section class:list={['gb', { 'gb--embedded': embedded }]} id="anmeldungen">
	<header class="gb-head">
		<div class="gb-head-left">
			{!embedded && <h2 class="gb-title">Gästeliste</h2>}
			<p class:list={['gb-subtitle', { 'gb-subtitle--solo': embedded }]}>
				{people} {people === 1 ? 'Person' : 'Personen'} · {registrations.length} {reportsLabel}
			</p>
		</div>
		{
			registrations.length > 0 && (
				<div class="gb-actions">
					<button type="button" class="gb-action gb-action--export" data-export-excel>
						<AdminIcon name="download" width="14" height="14" />
						Excel exportieren
					</button>
					<button type="button" class="gb-action gb-action--danger" data-clear-regs data-event-id={eventId}>Liste löschen</button>
				</div>
			)
		}
	</header>

	{
		registrations.length === 0 ? (
			<p class="gb-empty">Noch keine Anmeldungen vorhanden.</p>
		) : (
			<div class="gb-body">
				<div class="gb-scroll" role="list">
					{registrations.map((row) => {
						const pairs = answerPairsForGuest(registrationForm, row.answers);
						return (
							<article class="gb-row" role="listitem">
								<span class="gb-avatar" aria-hidden="true">{initial(row.name)}</span>
								<div class="gb-info">
									<div class="gb-info-top">
										<p class="gb-name">{row.name}</p>
										<span class="gb-people">{row.guests} {row.guests === 1 ? 'Person' : 'Pers.'}</span>
									</div>
									<p class="gb-meta">{row.email} · {row.ticketCode ?? '—'} · {formatWhen(row.createdAt)}</p>
									{
										pairs.length > 0 && (
											<div class="gb-answers">
												{pairs.map((p) => (
													<span class="gb-answer-tag">
														<span class="gb-answer-label">{p.question}:</span> {p.answer}
													</span>
												))}
											</div>
										)
									}
								</div>
							</article>
						);
					})}
				</div>

				{
					showOverview && (
						<aside class="gb-aside">
							<h3 class="gb-aside-title">Auswertung</h3>
							<div class="gb-stats">
								{overview.map((item) => (
									<div class="gb-stat">
										<p class="gb-stat-q">{item.question}</p>
										{
											item.options && (
												<div class="gb-stat-options">
													{item.options.map((option) => (
														<div class="gb-stat-row">
															<span class="gb-stat-label">{option.label}</span>
															<span class="gb-bar-track"><span class="gb-bar-fill" style={`width:${barWidth(option.count)}`} /></span>
															<span class="gb-stat-count">{option.count}</span>
														</div>
													))}
												</div>
											)
										}
										{item.sum !== undefined && <p class="gb-stat-metric">Summe: <strong>{item.sum}</strong></p>}
										{item.answered !== undefined && <p class="gb-stat-metric">Ausgefüllt: <strong>{item.answered}</strong> von {registrations.length}</p>}
									</div>
								))}
							</div>
						</aside>
					)
				}
			</div>
		)
	}
</section>

{
	registrations.length > 0 && (
		<script
			type="application/json"
			id="guest-export-payload"
			set:html={JSON.stringify(exportPayload).replaceAll('<', '\\u003c')}
		/>
	)
}

<script>
	import { initGuestListExport } from '../scripts/guest-list-export.ts';

	initGuestListExport();
</script>

<style>
	.gb {
		margin: 2rem 0 0;
		padding: 1.5rem 0 0;
		border-top: 1px solid #e4e0d8;
		scroll-margin-top: 5.5rem;
	}

	.gb--embedded {
		margin: 0;
		padding: 0;
		border-top: none;
		scroll-margin-top: 0;
	}

	.gb-subtitle--solo {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 600;
		color: #475569;
	}

	/* ─── Header ─── */

	.gb-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-bottom: 1rem;
	}

	.gb-title {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 700;
		color: #1a1a1a;
	}

	.gb-subtitle {
		margin: 0.15rem 0 0;
		font-size: 0.88rem;
		color: #6b7280;
	}

	.gb-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.gb-action {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.4rem 0.75rem;
		border: 1px solid #e0dcd4;
		border-radius: 6px;
		background: #fff;
		font-size: 0.84rem;
		font-weight: 550;
		color: #3d3d3d;
		cursor: pointer;
		transition: all 0.15s;
	}

	.gb-action :global(svg) {
		width: 14px;
		height: 14px;
		display: block;
	}

	.gb-action:hover {
		background: #f6f3ee;
		border-color: #c8c2b6;
	}

	.gb-action--danger {
		border-color: transparent;
		background: none;
		color: #8c8c8c;
	}

	.gb-action--danger:hover {
		color: #b02e2e;
		background: #fef2f2;
		border-color: #fecaca;
	}

	.gb-empty {
		margin: 0;
		padding: 1.5rem 0;
		font-size: 0.92rem;
		color: #8a8a8a;
	}

	/* ─── Body grid: guests left, stats right ─── */

	.gb-body {
		display: grid;
		grid-template-columns: 1fr 18rem;
		gap: 1.25rem;
		align-items: start;
	}

	/* ─── Guest list (scrollable) ─── */

	.gb-scroll {
		max-height: 26rem;
		overflow-y: auto;
		border: 1px solid #eae6de;
		border-radius: 8px;
		background: #fff;
		scrollbar-width: thin;
		scrollbar-color: #d4cfc5 transparent;
	}

	.gb--embedded .gb-scroll {
		max-height: min(34rem, calc(100vh - 15rem));
	}

	.gb--embedded .gb-body {
		grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
	}

	.gb-scroll::-webkit-scrollbar { width: 5px; }
	.gb-scroll::-webkit-scrollbar-thumb { background: #d4cfc5; border-radius: 3px; }

	.gb-row {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.65rem;
		padding: 0.75rem 0.9rem;
		border-bottom: 1px solid #f3efe8;
		align-items: start;
	}

	.gb-row:last-child { border-bottom: 0; }
	.gb-row:hover { background: #fcfaf7; }

	.gb-avatar {
		width: 2rem;
		height: 2rem;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: #f0ebe2;
		color: #6d6250;
		font-size: 0.78rem;
		font-weight: 700;
	}

	.gb-info { min-width: 0; }

	.gb-info-top {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.gb-name {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 650;
		color: #1a1a1a;
	}

	.gb-people {
		font-size: 0.8rem;
		color: #6b7280;
		white-space: nowrap;
	}

	.gb-meta {
		margin: 0.15rem 0 0;
		font-size: 0.82rem;
		color: #8a8a8a;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.gb-answers {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		margin-top: 0.35rem;
	}

	.gb-answer-tag {
		display: inline-block;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		background: #f4f0e8;
		font-size: 0.8rem;
		color: #3d3d3d;
		line-height: 1.5;
	}

	.gb-answer-label {
		color: #7a7a7a;
	}

	/* ─── Auswertung sidebar ─── */

	.gb-aside {
		padding: 1rem 1.1rem;
		border: 1px solid #eae4d8;
		border-radius: 8px;
		background: #faf7f1;
	}

	.gb-aside-title {
		margin: 0 0 0.85rem;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #8a7349;
	}

	.gb-stats {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.gb-stat + .gb-stat {
		padding-top: 1rem;
		border-top: 1px solid #e8e0d2;
	}

	.gb-stat-q {
		margin: 0 0 0.45rem;
		font-size: 0.88rem;
		font-weight: 650;
		color: #2d2d2d;
	}

	.gb-stat-options {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.gb-stat-row {
		display: grid;
		grid-template-columns: 5.5rem 1fr 1.5rem;
		gap: 0.5rem;
		align-items: center;
	}

	.gb-stat-label {
		font-size: 0.84rem;
		color: #4a4a4a;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.gb-bar-track {
		display: block;
		height: 6px;
		background: #e8e0d2;
		border-radius: 3px;
		overflow: hidden;
	}

	.gb-bar-fill {
		display: block;
		height: 100%;
		background: linear-gradient(90deg, #b89a62, #a18650);
		border-radius: 3px;
		transition: width 0.3s ease;
	}

	.gb-stat-count {
		font-size: 0.84rem;
		font-weight: 700;
		text-align: right;
		color: #2d2d2d;
		font-variant-numeric: tabular-nums;
	}

	.gb-stat-metric {
		margin: 0.35rem 0 0;
		font-size: 0.84rem;
		color: #5a5f52;
	}

	.gb-stat-metric strong {
		color: #2d2d2d;
	}

	/* ─── Responsive ─── */

	@media (max-width: 900px) {
		.gb-body {
			grid-template-columns: 1fr;
		}

		.gb-aside {
			order: -1;
		}
	}
</style>

<script>
	const clearButton = document.querySelector<HTMLButtonElement>('[data-clear-regs]');
	clearButton?.addEventListener('click', async () => {
		const eventId = clearButton.dataset.eventId;
		if (!eventId) return;
		if (
			!confirm(
				'Liste wirklich löschen? Das kann nicht rückgängig gemacht werden. Alle Tickets zu diesem Event werden ungültig.',
			)
		) {
			return;
		}

		const res = await fetch('/api/clear-registrations', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ eventId }),
		});
		if (!res.ok) {
			alert('Liste konnte nicht gelöscht werden.');
			return;
		}
		window.location.reload();
	});
</script>
