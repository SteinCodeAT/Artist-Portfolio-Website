---
interface Props {
	lang: string;
	pageTitle: string;
	heading: string;
	subtitle: string;
	logoSrc?: string;
	accentColor?: string;
	accentColorDark?: string;
	backgroundColor?: string;
	next: string;
	csrfToken: string;
	csrfFieldName: string;
	error?: string | null;
	usernameLabel?: string;
	passwordLabel?: string;
	submitLabel?: string;
}

const {
	lang,
	pageTitle,
	heading,
	subtitle,
	logoSrc,
	accentColor = '#2f6f6a',
	accentColorDark = '#255955',
	backgroundColor = '#f4f1ea',
	next,
	csrfToken,
	csrfFieldName,
	error,
	usernameLabel = 'Benutzername',
	passwordLabel = 'Passwort',
	submitLabel = 'Anmelden',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{pageTitle}</title>
		<style define:vars={{ accentColor, accentColorDark, backgroundColor }}>
			:root {
				color-scheme: light;
				font-family: system-ui, sans-serif;
				line-height: 1.5;
				--text-scale: 1.1;
			}
		
			html {
				font-size: calc(100% * var(--text-scale));
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				background: var(--backgroundColor);
				color: #1f2933;
			}

			.card {
				width: min(420px, calc(100vw - 2rem));
				background: #fff;
				border-radius: 12px;
				padding: 2rem;
				box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
			}

			.login-logo {
				display: block;
				max-width: 120px;
				max-height: 48px;
				margin: 0 auto 1rem;
				object-fit: contain;
			}

			h1 {
				margin: 0 0 0.25rem;
				font-size: 1.5rem;
				text-align: center;
			}

			.subtitle {
				margin: 0 0 1.5rem;
				color: #52606d;
				text-align: center;
			}

			label {
				display: block;
				font-weight: 600;
				margin-bottom: 0.35rem;
			}

			input[type='text'],
			input[type='password'] {
				width: 100%;
				box-sizing: border-box;
				padding: 0.65rem 0.75rem;
				border: 1px solid #cbd2d9;
				border-radius: 8px;
				margin-bottom: 1rem;
				font: inherit;
			}

			button {
				width: 100%;
				border: 0;
				border-radius: 8px;
				padding: 0.75rem 1rem;
				background: var(--accentColor);
				color: #fff;
				font: inherit;
				font-weight: 600;
				cursor: pointer;
			}

			button:hover {
				background: var(--accentColorDark);
			}

			.error {
				background: #fde8e8;
				color: #9b1c1c;
				padding: 0.75rem 1rem;
				border-radius: 8px;
				margin-bottom: 1rem;
			}
		</style>
	</head>
	<body>
		<main class="card">
			{logoSrc && <img class="login-logo" src={logoSrc} alt="" />}
			<h1>{heading}</h1>
			<p class="subtitle">{subtitle}</p>

			{error === '1' && (
				<div class="error" role="alert">Benutzername oder Passwort ungültig.</div>
			)}
			{error === 'csrf' && (
				<div class="error" role="alert">Sitzung abgelaufen — bitte erneut anmelden.</div>
			)}
			{error === 'rate' && (
				<div class="error" role="alert">Zu viele Versuche. Bitte in 15 Minuten erneut versuchen.</div>
			)}

			<form method="post" data-admin-login-form>
				<input type="hidden" name="next" value={next} />
				<input type="hidden" name={csrfFieldName} value={csrfToken} />

				<label for="username">{usernameLabel}</label>
				<input id="username" name="username" type="text" autocomplete="username" required />

				<label for="password">{passwordLabel}</label>
				<input
					id="password"
					name="password"
					type="password"
					autocomplete="current-password"
					required
				/>

				<button type="submit">{submitLabel}</button>
			</form>
		</main>
	</body>
</html>

<script>
	import { initAdminLoginBait } from '@steincms/cms/forms/registration-form-client';

	initAdminLoginBait();
</script>
