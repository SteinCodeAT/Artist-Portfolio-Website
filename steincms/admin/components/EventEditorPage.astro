		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		padding: 0.85rem;
		border: 1px solid #e4e7ec;
		border-radius: 10px;
		background: #fff;
		cursor: pointer;
		text-align: left;
		font: inherit;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
