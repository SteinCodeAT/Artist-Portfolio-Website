		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.blocks-section {
		margin: 0;
	}

	.blocks-toolbar {
		margin-bottom: 1rem;
	}

	.content-add-picker {
		margin-top: 1.25rem;
		padding: 1rem;
		border: 1px dashed #c9cdd4;
		border-radius: 12px;
		background: #fafbfc;
	}

	.content-add-heading {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
		color: #1a2744;
	}

	.content-add-hint {
		margin: 0.25rem 0 0.85rem;
		font-size: 0.95rem;
		color: #4a5568;
	}

