	.reg-examples-hint {
		margin-top: 0.85rem;
		padding: 0.65rem 0.9rem;
		border-radius: 8px;
		background: #f5f0e6;
		border: 1px solid #e8dfce;
		font-size: 0.85rem;
		color: #5a4a2a;
		line-height: 1.5;
	}

	.reg-examples-hint strong {
		color: #3d3017;
