	/* ─── Edit / Gästeliste tabs (card style) ─── */

	.editor-shell {
		margin-top: 0.15rem;
	}

	.editor-tab-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin: 0 0 0;
		padding: 0;
		border-bottom: none;
	}

	.editor-tab {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		min-width: min(100%, 11.5rem);
		padding: 0.75rem 1rem;
		border: 1px solid #d8dee8;
		border-radius: 12px 12px 0 0;
		background: #eef1f6;
		font: inherit;
		text-align: left;
		color: #64748b;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.15s ease;
	}

	.editor-tab:hover {
		color: #334155;
		background: #f8fafc;
		border-color: #c5cad4;
	}

	.editor-tab[aria-selected='true'] {
		color: #1a2744;
		background: #fff;
		border-color: #d8dee8;
		border-bottom-color: #fff;
		box-shadow: 0 -2px 12px rgba(26, 39, 68, 0.05);
		transform: translateY(1px);
		z-index: 1;
