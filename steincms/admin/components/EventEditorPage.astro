---
import ContentSectionStyles from './ContentSectionStyles.astro';
import type { EventEditorSource } from '@steincms/cms/events/event-body-blocks';
import type { EventRecordBase } from '@steincms/cms/events/events-store';
import {
	DEFAULT_MAX_ATTENDEES,
	DEFAULT_MAX_GUESTS,
	EMPTY_REGISTRATION_FORM,
	MAX_MAX_ATTENDEES,
	MAX_MAX_GUESTS,
} from '@steincms/cms/events/registration-form';
import { eventEditorPanelsFromRecord, type RecordDef } from '@steincms/cms/schema';
import type { EventEditorPaths } from '../event-editor-state';

export interface CategoryOption {
	value: string;
	label: string;
}

export type EventEditorGuestTab = {
	people: number;
	registrationCount: number;
};

interface Props {
	source: EventEditorSource | null;
	paths: EventEditorPaths;
	record: RecordDef;
	event?: EventRecordBase | null;
	editorEventId: string;
	isEdit: boolean;
	fromCalendar: boolean;
	backHref: string;
	backLabel: string;
	categoryOptions: CategoryOption[];
	fallbackCoverSrc: string;
	prefillDate?: string | null;
	coverAssetsHint?: string;
	/** When set, shows Bearbeiten / Gästeliste tabs instead of stacking guest content above the form. */
	guestTab?: EventEditorGuestTab | null;
}

const {
	source,
	paths,
	record,
	event = null,
	editorEventId,
	isEdit,
	fromCalendar,
	backHref,
	backLabel,
	categoryOptions,
	fallbackCoverSrc,
	prefillDate = null,
	coverAssetsHint = 'Cover-Bilder werden beim Speichern in den Medienordner der Veranstaltung hochgeladen.',
	guestTab = null,
} = Astro.props;

const hasGuestTab = Boolean(guestTab);

const adminPath = paths.admin;
const eventsPublicPath = paths.public;
const eventsListPath = paths.list;
const eventsCalendarPath = paths.calendar;

const panels = eventEditorPanelsFromRecord(record);
const showBlocksPanel = panels.showBlocksPanel;
const showGalleryPanel = panels.showGalleryPanel;
const showRegistrationPanel = panels.showRegistrationPanel;
const blocksLabel = panels.blocksLabel ?? 'Artikeltext';
const galleryLabel = panels.galleryLabel ?? 'Veranstaltungsbilder';
const registrationLabel = panels.registrationLabel ?? 'Anmeldeformular';

const eventTitle = source?.title ?? '';
const eventDate = source?.date ?? null;
const eventCategory = source?.category ?? event?.category;
const eventLocation = event?.location ?? '';
const eventExcerpt = source?.excerpt ?? '';
const eventCover = source?.cover ?? '';
const eventSlug = event?.slug;
const editingDraft = source?.editingDraft ?? false;
const hasPreviewDraft = Boolean(event?.previewDraft);
const initialBlocks = source?.initialBlocks ?? [];
const initialGallery = source?.initialGallery ?? [];
const initialRegistrationForm = source?.registrationForm ?? EMPTY_REGISTRATION_FORM;
---

<ContentSectionStyles />

<header class="editor-toolbar editor-toolbar-sticky">
	<div class="editor-toolbar-left">
		<a class="back-link" href={backHref}>{backLabel}</a>
		<input
			type="text"
			id="event-title"
			name="title"
			class="editor-title-input"
			placeholder="Titel der Veranstaltung"
			required
			value={eventTitle}
		/>
	</div>
	<div class="toolbar-actions">
		<slot name="toolbar-actions" />
		<span class="save-status" id="save-status" aria-live="polite"></span>
		{
			editingDraft && (
				<span class="draft-badge" title="Gespeicherter Entwurf — noch nicht veröffentlicht">
					Entwurf
				</span>
			)
		}
		<button
			type="button"
			class="btn-ghost"
			id="btn-preview"
			title="Zeigt den Entwurf an, ohne die Website zu veröffentlichen"
		>
			Entwurfsvorschau
		</button>
		<div class="save-dropdown" data-save-dropdown>
			<button type="button" class="btn-primary save-dropdown-trigger" data-save-dropdown-trigger>
				Speichern ▾
			</button>
			<div class="save-dropdown-menu" data-save-dropdown-menu hidden>
				<button type="button" class="save-dropdown-item" data-save-action="save-draft">
					<strong>Entwurf speichern</strong>
					<small>Nur Entwurf — Website bleibt unverändert</small>
				</button>
				<button type="button" class="save-dropdown-item" data-save-action="publish">
					<strong>Speichern &amp; Veröffentlichen</strong>
					<small>Entwurf übernehmen und live schalten</small>
				</button>
				<button
					type="button"
					class="save-dropdown-item save-dropdown-item-danger"
					data-save-action="discard-draft"
					hidden={!hasPreviewDraft}
				>
					<strong>Entwurf verwerfen</strong>
					<small>Zurück zum veröffentlichten Stand</small>
				</button>
			</div>
		</div>
	</div>
</header>

{!hasGuestTab && <slot name="after-toolbar" />}

<div class:list={['editor-body', { 'editor-shell': hasGuestTab }]} data-editor-shell={hasGuestTab ? '' : undefined}>
	{
		hasGuestTab && (
			<nav class="editor-tab-bar" role="tablist" aria-label="Event-Bereiche">
				<button
					type="button"
					class="editor-tab"
					role="tab"
					id="editor-tab-edit"
					aria-controls="editor-panel-edit"
					aria-selected="true"
					data-editor-tab="edit"
				>
					<span class="editor-tab-icon" aria-hidden="true">✎</span>
					<span class="editor-tab-copy">
						<span class="editor-tab-label">Bearbeiten</span>
						<span class="editor-tab-hint">Inhalt & Einstellungen</span>
					</span>
				</button>
				<button
					type="button"
					class="editor-tab"
					role="tab"
					id="editor-tab-guests"
					aria-controls="editor-panel-guests"
					aria-selected="false"
					data-editor-tab="guests"
				>
					<span class="editor-tab-icon editor-tab-icon--guests" aria-hidden="true">
					<!-- svg for person icon -->
					
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
						<path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438zM15.53 5.47a.75.75 0 1 0-1.06 1.06L16.94 8.5h-8.5a.75.75 0 0 0 0 1.5h8.5l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3a.75.75 0 0 0 0-1.06l-3-3z" clip-rule="evenodd" />
					</svg>
					</span>
					<span class="editor-tab-copy">
						<span class="editor-tab-label">
							Gästeliste
							<span class="editor-tab-badge">{guestTab!.people}</span>
						</span>
						<span class="editor-tab-hint">
							{guestTab!.registrationCount}{' '}
							{guestTab!.registrationCount === 1 ? 'Anmeldung' : 'Anmeldungen'} · Auswertung
						</span>
					</span>
				</button>
			</nav>
		)
	}

	<div class="editor-tab-root" data-editor-tabs={hasGuestTab ? '' : undefined}>
		<div
			class:list={[{ 'editor-tab-panel': hasGuestTab }]}
			id={hasGuestTab ? 'editor-panel-edit' : undefined}
			role={hasGuestTab ? 'tabpanel' : undefined}
			aria-labelledby={hasGuestTab ? 'editor-tab-edit' : undefined}
			data-editor-panel={hasGuestTab ? 'edit' : undefined}
		>
			<form class="editor-form" id="post-form" onsubmit="return false;">
	<div class="editor-layout">
		<div class="editor-main">
			{
				showBlocksPanel && (
			<section
				class="blocks-section editor-panel"
				id="content-sections-root"
				data-event-id={editorEventId}
				data-event-persisted={isEdit ? 'true' : 'false'}
				data-upload-content-type="events"
				data-return-to={fromCalendar ? 'calendar' : 'list'}
				data-admin-path={adminPath}
				data-events-public-path={eventsPublicPath}
				data-events-list-path={eventsListPath}
				data-events-calendar-path={eventsCalendarPath}
				data-event-slug={eventSlug ?? ''}
				data-has-preview-draft={hasPreviewDraft ? 'true' : 'false'}
				data-initial-blocks={JSON.stringify(initialBlocks)}
			>
				<div class="blocks-toolbar">
					<div>
						<h2 class="panel-title">{blocksLabel}</h2>
						<p class="panel-subtitle">
							Hier schreiben Sie den Beitrag. Für Eckdaten (Datum, Ort, …) fügen Sie eine
							<strong>Tabelle</strong> ein.
						</p>
					</div>
				</div>
				<div data-section-list></div>

				<div class="content-add-picker" aria-label="Neuen Abschnitt einfügen">
					<p class="content-add-heading">Abschnitt einfügen</p>
					<p class="content-add-hint">Wählen Sie, was als Nächstes folgen soll.</p>
					<div class="content-add-options content-add-options--four">
						<button type="button" class="content-add-option" data-add-text>
							<span class="content-add-icon" aria-hidden="true">¶</span>
							<span class="content-add-text">
								<strong>Text</strong>
								<small>Absätze, Überschriften, Listen</small>
							</span>
						</button>
						<button type="button" class="content-add-option" data-add-image>
							<span class="content-add-icon content-add-icon-image" aria-hidden="true">B</span>
							<span class="content-add-text">
								<strong>Einzelbild</strong>
								<small>Ein Foto mit Bildunterschrift</small>
							</span>
						</button>
						<button type="button" class="content-add-option" data-add-table>
							<span class="content-add-icon content-add-icon-table" aria-hidden="true">⊞</span>
							<span class="content-add-text">
								<strong>Tabelle</strong>
								<small>Eckdaten, Termine, Infokasten</small>
							</span>
						</button>
					</div>
				</div>
			</section>
				)
			}

			{
				showGalleryPanel && (
			<section
				class="editor-panel event-gallery-panel"
				id="event-gallery-root"
				data-event-id={editorEventId}
				data-initial-gallery={JSON.stringify(initialGallery)}
				aria-labelledby="event-gallery-heading"
			>
				<div class="blocks-toolbar">
					<div>
						<h2 class="panel-title" id="event-gallery-heading">{galleryLabel}</h2>
						<p class="panel-subtitle">
							Fotos von der Veranstaltung — erscheinen am Ende der Seite, getrennt vom
							Artikeltext. Hier keine Einzelbilder für den Fließtext einfügen.
						</p>
					</div>
				</div>
				<div class="block-gallery-body">
					<div class="block-gallery-grid" data-event-gallery-grid></div>
					<div class="block-upload">
						<input
							type="file"
							accept="image/jpeg,image/png,image/webp,image/gif"
							data-event-gallery-files
							multiple
							hidden
						/>
						<button type="button" class="block-action-btn" data-event-gallery-upload>
							Bilder hochladen
						</button>
					</div>
				</div>
			</section>
				)
			}

			{
				showRegistrationPanel && (
			<section
				class="editor-panel reg-form-panel"
				id="reg-form-builder"
				data-reg-form-builder
				aria-labelledby="reg-form-heading"
			>
				<div class="blocks-toolbar">
					<div>
						<h2 class="panel-title" id="reg-form-heading">
							<span class="panel-title-icon" aria-hidden="true">&#9998;</span>
							{registrationLabel}
						</h2>
						<p class="panel-subtitle">
							Optional. Ohne Aktivierung erscheint auf der Eventseite kein Formular.
						</p>
					</div>
				</div>

				<input
					type="hidden"
					id="event-registration-form"
					value={JSON.stringify(initialRegistrationForm)}
				/>

				<label class="reg-enable-toggle">
					<input type="checkbox" data-reg-enabled checked={initialRegistrationForm.enabled} />
					<span>
						<strong>Anmeldung aktivieren</strong>
						<small>Name, E-Mail und Personenanzahl plus Ihre Extra-Fragen</small>
					</span>
				</label>

				<div class="reg-builder-body" data-reg-builder-body hidden={!initialRegistrationForm.enabled}>
					<div class="reg-defaults-strip">
						<span class="reg-default-chip">Name</span>
						<span class="reg-default-chip">E-Mail</span>
						<span class="reg-default-chip">Personenanzahl</span>
					</div>

					<div class="reg-limits">
						<label class="field">
							<span class="field-label-inline">Maximale Teilnehmerzahl</span>
							<input
								type="number"
								data-reg-max-attendees
								min="1"
								max={MAX_MAX_ATTENDEES}
								step="1"
								value={initialRegistrationForm.maxAttendees ?? DEFAULT_MAX_ATTENDEES}
								required
							/>
							<small class="field-hint-inline">Gesamtzahl der Personen für diese Veranstaltung.</small>
						</label>
						<label class="field">
							<span class="field-label-inline">Max. Personen pro Anmeldung</span>
							<input
								type="number"
								data-reg-max-guests
								min="1"
								max={MAX_MAX_GUESTS}
								step="1"
								value={initialRegistrationForm.maxGuests ?? DEFAULT_MAX_GUESTS}
								required
							/>
							<small class="field-hint-inline">Obergrenze in einem einzelnen Formular.</small>
						</label>
					</div>

					<div class="reg-fields-container" data-reg-fields></div>

					<button type="button" class="reg-add-field-btn" data-reg-add-field>
						<span class="reg-add-field-icon" aria-hidden="true">+</span>
						Frage hinzufügen
					</button>

					<div class="reg-examples-hint">
						<strong>Beispiele:</strong> Vegetarisch / Vegan? &middot; Parkplatz-Wunsch &middot; Wie reist du an? &middot; Besondere Wünsche
					</div>
				</div>
			</section>
				)
			}

			
		</div>

		<aside class="editor-sidebar" aria-label="Veranstaltungs-Einstellungen">
			<div class="editor-sidebar-shell">
				<header class="editor-sidebar-header">
					<span class="sidebar-header-icon" aria-hidden="true">&#9881;</span>
					<div>
						<h2 class="sidebar-column-title">Event-Details</h2>
						<p class="sidebar-column-hint">
							Wann, wo, welche Kategorie und Teaser.
						</p>
					</div>
				</header>

				<section class="editor-sidebar-card editor-sidebar-card-highlight">
					<h3 class="sidebar-card-title">
						<span class="sidebar-card-icon" aria-hidden="true">&#128197;</span>
						Termin &amp; Ort
					</h3>
					<label class="field">
						<span class="field-label-inline">Datum</span>
						<input type="date" id="event-date" name="date" value={eventDate ?? prefillDate ?? ''} />
					</label>
					<label class="field">
						<span class="field-label-inline">Ort / Veranstaltungsort</span>
						<input
							type="text"
							id="event-location"
							name="location"
							placeholder="z.B. Alte Donau, Vereinshaus, Online…"
							value={eventLocation ?? ''}
							maxlength="120"
						/>
					</label>
					<label class="field">
						<span class="field-label-inline">Kategorie</span>
						<select id="event-category-select" name="category">
							{categoryOptions.map((option) => (
								<option
									value={option.value}
									selected={
										eventCategory === option.value ||
										(!eventCategory && option.value === categoryOptions[0]?.value)
									}
								>
									{option.label}
								</option>
							))}
							<option value="__new__" selected={Boolean(eventCategory && !categoryOptions.some((o) => o.value === eventCategory))}>
								+ Neue Kategorie…
							</option>
						</select>
						<input
							type="text"
							id="event-category-custom"
							class="event-category-custom"
							placeholder="Neue Kategorie eingeben…"
							value={
								eventCategory && !categoryOptions.some((o) => o.value === eventCategory)
									? eventCategory
									: ''
							}
							maxlength="40"
							hidden={!eventCategory || categoryOptions.some((o) => o.value === eventCategory)}
						/>
						<small class="field-hint-inline">Bestehende Kategorie wählen oder „Neue Kategorie…" nutzen.</small>
					</label>
					{isEdit && eventSlug && (
						<p class="sidebar-new-hint">
							Öffentliche Seite:{' '}
							<a href={`${eventsPublicPath}/${eventSlug}`} target="_blank" rel="noopener">
								{eventsPublicPath}/{eventSlug}
							</a>
						</p>
					)}
				</section>

				<section class="editor-sidebar-card">
					<h3 class="sidebar-card-title">
						<span class="sidebar-card-icon" aria-hidden="true">&#9998;</span>
						Kurztext
					</h3>
					<label class="field">
						<small class="field-hint">Teaser für die Veranstaltungs-Übersicht (max. 2–3 Sätze).</small>
						<textarea
							id="event-excerpt"
							name="excerpt"
							rows="4"
							placeholder="Worum geht es bei dieser Veranstaltung?"
						>{eventExcerpt}</textarea>
					</label>
				</section>


				<section
					class="editor-sidebar-card main-image-field"
					aria-labelledby="main-image-label"
					data-fallback-cover={fallbackCoverSrc}
				>
					<div class="field">
						<span id="main-image-label" class="sidebar-card-title"><span class="sidebar-card-icon" aria-hidden="true">&#128247;</span> Cover-Bild</span>
						<small class="field-hint">
							{coverAssetsHint}
						</small>
					</div>
					<div class="main-image-preview-wrap">
						<div class="main-image-preview" id="main-image-preview"></div>
					</div>
					<label class="field">
						<span class="field-label-inline">Dateiname / Upload-URL</span>
						<input
							type="text"
							id="event-cover-filename"
							placeholder="slug-01-01-2026.webp"
							value={eventCover ?? ''}
						/>
					</label>
					<input type="hidden" id="event-cover" value={eventCover ?? ''} />
					<input
						type="file"
						id="event-cover-file"
						accept="image/jpeg,image/png,image/webp,image/gif"
						hidden
					/>
					<div class="main-image-actions">
						<button type="button" class="btn-ghost btn-sm" id="btn-cover-upload">
							Cover hochladen
						</button>
					</div>
				</section>
			</div>
		</aside>
	</div>
			</form>
		</div>

		{
			hasGuestTab && (
				<div
					class="editor-tab-panel"
					id="editor-panel-guests"
					role="tabpanel"
					aria-labelledby="editor-tab-guests"
					data-editor-panel="guests"
					hidden
				>
					<div class="editor-guests-shell">
						<slot name="guests-panel" />
					</div>
				</div>
			)
		}
	</div>
</div>

{!hasGuestTab && <slot name="after-form" />}

<script>
	import '../scripts/event-form-editor.ts';
</script>

{
	hasGuestTab && (
		<script is:inline>
			(() => {
				const shell = document.querySelector('[data-editor-shell]');
				if (!shell) return;

				const tabButtons = shell.querySelectorAll('[data-editor-tab]');
				const panels = shell.querySelectorAll('[data-editor-panel]');
				if (!tabButtons.length || !panels.length) return;

				const validTabs = new Set(['edit', 'guests']);

				const setTab = (tabId, pushState = true) => {
					if (!validTabs.has(tabId)) tabId = 'edit';

					tabButtons.forEach((button) => {
						const active = button.getAttribute('data-editor-tab') === tabId;
						button.setAttribute('aria-selected', active ? 'true' : 'false');
					});

					panels.forEach((panel) => {
						const active = panel.getAttribute('data-editor-panel') === tabId;
						panel.hidden = !active;
					});

					if (pushState) {
						const url = new URL(window.location.href);
						if (tabId === 'guests') {
							url.searchParams.set('tab', 'gaeste');
						} else {
							url.searchParams.delete('tab');
						}
						window.history.replaceState({}, '', url);
					}
				};

				tabButtons.forEach((button) => {
					button.addEventListener('click', () => {
						setTab(button.getAttribute('data-editor-tab') ?? 'edit');
					});
				});

				const initialTab = new URLSearchParams(window.location.search).get('tab');
				setTab(initialTab === 'gaeste' ? 'guests' : 'edit', false);
			})();
		</script>
	)
}

<style>
	.editor-toolbar {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.editor-toolbar-sticky {
		position: sticky;
		top: 0;
		z-index: 20;
		background: #f5f6f8;
		padding: 0.5rem 0 1rem;
		margin: -0.5rem 0 1.25rem;
		border-bottom: 1px solid #dde1e8;
	}

	.editor-toolbar-left {
		flex: 1;
		min-width: min(100%, 280px);
	}

	.back-link {
		display: inline-block;
		margin-bottom: 0.35rem;
		color: #666;
		text-decoration: none;
		font-size: 0.85rem;
	}

	.back-link:hover {
		color: #1a1a1a;
	}

	.editor-title-input {
		display: block;
		width: 100%;
		max-width: 560px;
		padding: 0.35rem 0;
		border: none;
		background: transparent;
		font: inherit;
		font-size: clamp(1.25rem, 2.2vw, 1.65rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: #1a1a1a;
	}

	.editor-title-input::placeholder {
		color: #9aa3af;
		font-weight: 600;
	}

	.editor-title-input:focus {
		outline: none;
		box-shadow: inset 0 -2px 0 #a18b63;
	}

	.toolbar-actions {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		align-items: center;
	}

	.editor-form {
		display: block;
	}

	.editor-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 340px;
		gap: 1.5rem;
		align-items: start;
	}

	.editor-main {
		min-width: 0;
	}

	.editor-panel {
		background: #fff;
		border: 1px solid #e8e8e8;
		border-radius: 12px;
		padding: 1.25rem;
		box-shadow: 0 1px 3px rgba(16, 24, 40, 0.04);
	}

