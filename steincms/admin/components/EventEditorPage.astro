		border-radius: 10px;
		background: #fffef8;
		font: inherit;
		font-size: 1rem;
		font-weight: 700;
		color: #7a5f1e;
		cursor: pointer;
		transition: background 0.15s, border-color 0.15s, transform 0.1s;
	}

