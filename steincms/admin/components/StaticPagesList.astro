---
import DashboardCard from './DashboardCard.astro';
import DashboardCardList from './DashboardCardList.astro';
import type { StaticPageEntry } from '../nav';

interface Props {
	pages: StaticPageEntry[];
	description?: string;
}

const { pages, description = 'Inhalte der öffentlichen Seite bearbeiten' } = Astro.props;
---

<DashboardCardList>
	{
		pages.map((page) => (
			<DashboardCard
				href={page.href}
				title={page.label}
				description={description}
				icon="pages"
			/>
		))
	}
</DashboardCardList>
