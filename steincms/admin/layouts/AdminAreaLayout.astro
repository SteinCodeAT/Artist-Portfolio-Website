---
import AdminUiStyles from '../components/AdminUiStyles.astro';
import AdminNavLink from '../components/AdminNavLink.astro';
import AdminIcon from '../icons/AdminIcon.astro';
import { getAuthenticatedUsername } from '@steincms/auth/admin-auth';
import type { AdminNavItem } from '../types/admin-nav';

interface Props {
  title?: string;
  activeSection?: string;
  adminPath: string;
  adminTitle: string;
  siteName: string;
  siteShortName: string;
  adminLogoSrc: string;
  navItems: AdminNavItem[];
  wideContent?: boolean;
}
const {
  title = 'Termine Manager',
  activeSection = 'calendar',
  adminPath,
  adminTitle,
  siteName,
  siteShortName,
  adminLogoSrc,
  navItems,
  wideContent = false,
} = Astro.props;
const username = getAuthenticatedUsername(Astro.request);

/*
Admin Area Layout
┌─────────────────────────────────────┐
│  Sidebar (nav)  │  Main content     │
│  - Logo         │  ← Astro page      │
│  - Kalender     │     goes here     │
│  - Beiträge     │  (the <slot />)   │
│  - Logout       │                   │
└─────────────────────────────────────┘

Example:
<AdminAreaLayout title="Dashboard — Verwaltung" activeSection="home">
  <header class="dash-header">
    <div>
      <p class="dash-greeting">Willkommen zurück</p>
      <h1 class="dash-title">{username}</h1>
      <p class="dash-subtitle">Gemeinde-Verwaltung — Termine und Blog-Beiträge.</p>
    </div>
    <span class="dash-user-badge" title="Angemeldeter Benutzer">{username}</span>
  </header>
</AdminAreaLayout>
*/
---

<!doctype html>
<html lang="de">
    <head>
        <meta charset="UTF-8" />
        <meta name="robots" content="noindex, nofollow" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href="/planner-favicon.svg" />
        <AdminUiStyles />
        <style is:global>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                min-height: 100%;
                overflow-x: hidden;
                font-family:
                    system-ui,
                    -apple-system,
                    sans-serif;
                background: #f5f6f8;
                color: #1a1a1a;
            }

            .planner-app {
                display: flex;
                min-height: 100vh;
                overflow-x: hidden;
            }

            .planner-main {
                flex: 1;
                min-width: 0;
                padding: 1.5rem 1.25rem;
                background: #f5f6f8;
            }

            .planner-content {
                min-width: 0;
                overflow-x: hidden;
                width: 100%;
                max-width: 72rem;
                margin: 0 auto;
            }
            .planner-content.wide {
                max-width: 100%;
            }

            .planner-topbar {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                margin: -0.25rem 0 1rem;
                position: relative;
                z-index: 30;
            }

            .planner-user-menu {
                position: relative;
            }

            .planner-user {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                padding: 0.35rem 0.75rem;
                border-radius: 999px;
                background: #fff;
                border: 1px solid #dde1e8;
                font-size: 0.78rem;
                color: #475467;
                cursor: pointer;
                font: inherit;
                transition:
                    border-color 0.15s ease,
                    box-shadow 0.15s ease;
            }

            .planner-user:hover,
            .planner-user-menu.is-open .planner-user {
                border-color: #c5cad4;
                box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
            }

            .planner-user-chevron {
                width: 14px;
                height: 14px;
                color: #98a2b3;
                flex-shrink: 0;
                transition: transform 0.15s ease;
            }

            .planner-user-menu.is-open .planner-user-chevron {
                transform: rotate(180deg);
            }

            .planner-user-dropdown {
                position: absolute;
                top: calc(100% + 0.35rem);
                right: 0;
                min-width: 10rem;
                padding: 0.35rem;
                border-radius: 10px;
                background: #fff;
                border: 1px solid #dde1e8;
                box-shadow: 0 8px 24px rgba(15, 23, 42, 0.1);
                z-index: 20;
                display: none;
            }

            .planner-user-menu.is-open .planner-user-dropdown {
                display: block;
            }

            .planner-user-logout-form {
                margin: 0;
                padding: 0;
            }

            .planner-user-logout-btn {
                display: block;
                width: 100%;
                padding: 0.55rem 0.75rem;
                border: none;
                border-radius: 7px;
                background: transparent;
                color: #344054;
                font-family: inherit;
                font-size: 0.82rem;
                font-weight: 500;
                line-height: 1.4;
                text-align: left;
                cursor: pointer;
                appearance: none;
                -webkit-appearance: none;
                transition:
                    background 0.15s ease,
                    color 0.15s ease;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.5rem;
            }

            .planner-user-logout-btn:hover {
                background: #f5f6f8;
                color: #b42318;
            }

            .planner-user-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #12b76a;
                flex-shrink: 0;
            }

            .planner-user-name {
                font-weight: 600;
                color: #1a2744;
            }

            .planner-sidebar {
                position: relative;
                align-self: stretch;
                width: 88px;
                min-height: 100vh;
                background: #e9ecf1;
                border-right: 1px solid #dde1e8;
                flex-shrink: 0;
                z-index: 2;
            }

            .sidebar-top {
                position: fixed;
                top: 0;
                left: 0;
                width: 88px;
                z-index: 4;
                display: flex;
                justify-content: center;
                padding: 1.5rem 0 0.5rem;
                background: #e9ecf1;
            }

            .sidebar-fixed-nav {
                position: fixed;
                top: 50%;
                left: 0;
                width: 88px;
                transform: translateY(-50%);
                z-index: 3;
                display: flex;
                flex-direction: column;
                align-items: flex-end;
            }

            .sidebar-nav {
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                gap: 0.5rem;
                padding-right: 0;
                margin: 0;
            }

            .sidebar-footer-wrap {
                position: fixed;
                bottom: 1.25rem;
                left: 0;
                width: 88px;
                z-index: 3;
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                gap: 0.55rem;
            }

            .sidebar-logo {
                display: block;
                width: 52px;
                overflow: hidden;
                line-height: 1;
                text-decoration: none;
            }

            .sidebar-logo-img {
                display: block;
                width: 100%;
                height: auto;
                max-height: 44px;
                object-fit: contain;
            }

            .sidebar-logout-form {
                margin: 0;
                padding: 0;
            }

            .sidebar-btn {
                position: relative;
                width: 64px;
                min-height: 56px;
                border: none;
                border-radius: 0 22px 22px 0;
                background: transparent;
                cursor: pointer;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 0.16rem;
                color: #6b7280;
                padding: 0.4rem 0.2rem 0.35rem 0.1rem;
                margin-right: 0;
                transition:
                    color 0.15s ease,
                    background 0.15s ease,
                    width 0.15s ease,
                    margin-right 0.15s ease;
                text-decoration: none;
                font: inherit;
            }

            .sidebar-icon {
                width: 20px;
                height: 20px;
                position: relative;
                z-index: 1;
            }

            .sidebar-label {
                position: relative;
                z-index: 1;
                font-size: 0.54rem;
                font-weight: 700;
                letter-spacing: 0.01em;
                line-height: 1.15;
                text-align: center;
                max-width: 3.6rem;
                overflow: hidden;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                white-space: normal;
            }

            .planner-user-logout-icon {
                width: 14px;
                height: 14px;
                position: relative;
                z-index: 1;
            }

            /* Bookmark tab — active item sticks out into the main area */
            .sidebar-btn.is-active {
                width: 72px;
                margin-right: -14px;
                background: #fff;
                color: #aa6907;
                box-shadow:
                    2px 0 12px rgba(15, 23, 42, 0.06),
                    0 1px 0 rgba(255, 255, 255, 0.8) inset;
                z-index: 3;
            }

            .sidebar-btn.is-active::before,
            .sidebar-btn.is-active::after {
                content: '';
                position: absolute;
                right: 0;
                width: 14px;
                height: 14px;
                pointer-events: none;
            }

            .sidebar-btn.is-active::before {
                top: -14px;
                border-bottom-right-radius: 14px;
                box-shadow: 7px 0 0 0 #fff;
            }

            .sidebar-btn.is-active::after {
                bottom: -14px;
                border-top-right-radius: 14px;
                box-shadow: 7px 0 0 0 #fff;
            }

            .sidebar-btn:not(.is-active):not(:disabled):hover {
                color: #374151;
                background: rgba(255, 255, 255, 0.45);
                border-radius: 0 18px 18px 0;
                width: 68px;
                margin-right: -6px;
            }

            .sidebar-btn:disabled {
                opacity: 0.32;
                cursor: not-allowed;
            }

            .sidebar-footer {
                font-size: 0.58rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                color: #9aa3af;
                text-align: center;
                width: 100%;
                padding-right: 0.45rem;
            }

            .planner-mobile-nav {
                display: none;
            }

            .mobile-nav-tab {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 0.2rem;
                flex: 1;
                min-height: 44px;
                padding: 0.35rem 0.5rem;
                border: none;
                background: transparent;
                color: #6b7280;
                font: inherit;
                font-size: 0.62rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                text-decoration: none;
                cursor: pointer;
                transition: color 0.15s ease;
                box-sizing: border-box;
            }

            .mobile-nav-tab.is-active {
                color: #aa6907;
            }

            .mobile-nav-tab:disabled {
                opacity: 0.32;
                cursor: not-allowed;
            }

            .mobile-nav-icon {
                width: 20px;
                height: 20px;
            }

            .mobile-nav-logout-form {
                display: flex;
                flex: 1;
                margin: 0;
                padding: 0;
            }

            @media (min-width: 1600px) {
                .planner-main {
                    padding: 2rem 2.5rem;
                }
            }

            @media (max-width: 768px) {
                .planner-app {
                    flex-direction: column;
                }

                .planner-sidebar {
                    display: none;
                }

                .planner-main {
                    flex: 1;
                    padding: 1rem 1rem calc(4.5rem + env(safe-area-inset-bottom, 0px));
                }

                .planner-mobile-nav {
                    display: flex;
                    position: fixed;
                    bottom: 0;
                    left: 0;
                    right: 0;
                    z-index: 10;
                    justify-content: space-around;
                    align-items: stretch;
                    min-height: 56px;
                    padding-bottom: env(safe-area-inset-bottom, 0px);
                    background: #fff;
                    border-top: 1px solid #dde1e8;
                }

                .mobile-nav-tab {
                    font-size: 0.55rem;
                    letter-spacing: 0.04em;
                    padding: 0.35rem 0.2rem;
                    min-width: 0;
                }
            }
        </style>
    </head>
    <body>
        <div class="planner-app">
            <aside class="planner-sidebar" aria-label="Planner Navigation">
                <div class="sidebar-top">
                    <a href={adminPath} class="sidebar-logo" title="Dashboard" aria-label="Dashboard">
                        <img src={adminLogoSrc} alt="Logo" class="sidebar-logo-img" />
                    </a>
                </div>

                <div class="sidebar-fixed-nav">
                    <nav class="sidebar-nav">
                    {navItems.map((item) => (
                        <AdminNavLink item={item} activeSection={activeSection} variant="sidebar" />
                    ))}

                    <button
                        type="button"
                        class="sidebar-btn"
                        title="Einstellungen"
                        disabled
                    >
                        <AdminIcon name="settings" class="sidebar-icon" />
                        <span class="sidebar-label">Einstellungen</span>
                    </button>
                    </nav>
                </div>

                <div class="sidebar-footer-wrap">
                    <form action="/api/logout" method="POST" class="sidebar-logout-form">
                        <button
                            type="submit"
                            class="sidebar-btn"
                            title="Abmelden"
                            aria-label="Abmelden"
                        >
                            <AdminIcon name="logout" class="sidebar-icon" />
                            <span class="sidebar-label">Abmelden</span>
                        </button>
                    </form>
                    <div class="sidebar-footer">{siteShortName}</div>
                </div>
            </aside>

            <main class="planner-main" aria-label="Planner Main Content">
                {username && (
                    <div class="planner-topbar">
                        <div class="planner-user-menu" data-user-menu>
                            <button
                                type="button"
                                class="planner-user"
                                aria-haspopup="menu"
                                aria-expanded="false"
                                aria-controls="planner-user-dropdown"
                                data-user-menu-trigger
                            >
                                <span class="planner-user-dot" aria-hidden="true"></span>
                                <span>Angemeldet als</span>
                                <span class="planner-user-name">{username}</span>
                                <AdminIcon name="chevronDown" class="planner-user-chevron" />
                            </button>
                            <div
                                id="planner-user-dropdown"
                                class="planner-user-dropdown"
                                role="menu"
                                data-user-menu-dropdown
                            >
                                <form action="/api/logout" method="POST" class="planner-user-logout-form">
                                    <button type="submit" class="planner-user-logout-btn" role="menuitem">
                                        Abmelden
                                        <AdminIcon name="logout" class="planner-user-logout-icon" />
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                )}
                <div class={`planner-content ${wideContent ? 'wide' : ''}`}>
                    <slot />
                </div>
            </main>

            <nav class="planner-mobile-nav" aria-label="Planner Navigation">
                {navItems.map((item) => (
                    <AdminNavLink item={item} activeSection={activeSection} variant="mobile" />
                ))}

                <button type="button" class="mobile-nav-tab" title="Einstellungen" disabled>
                    <AdminIcon name="settings" class="mobile-nav-icon" />
                    Einstellungen
                </button>

            </nav>
        </div>
        <script is:inline>
            (() => {
                const menu = document.querySelector('[data-user-menu]');
                if (!menu) return;

                const trigger = menu.querySelector('[data-user-menu-trigger]');
                const dropdown = menu.querySelector('[data-user-menu-dropdown]');
                if (!trigger || !dropdown) return;

                const closeMenu = () => {
                    menu.classList.remove('is-open');
                    trigger.setAttribute('aria-expanded', 'false');
                };

                const openMenu = () => {
                    menu.classList.add('is-open');
                    trigger.setAttribute('aria-expanded', 'true');
                };

                const isOpen = () => menu.classList.contains('is-open');

                trigger.addEventListener('click', (event) => {
                    event.stopPropagation();
                    if (isOpen()) {
                        closeMenu();
                    } else {
                        openMenu();
                    }
                });

                document.addEventListener('click', (event) => {
                    if (!menu.contains(event.target)) {
                        closeMenu();
                    }
                });

                document.addEventListener('keydown', (event) => {
                    if (event.key === 'Escape') {
                        closeMenu();
                        trigger.focus();
                    }
                });
            })();
        </script>
    </body>
</html>
